{
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "all",
    "tabWidth": 2,
    "arrowParens": "always",
    "endOfLine": "lf",
    "overrides": [
        {
            "files": "*.html",
            "options": { "parser": "html" }
        },
        {
            "files": "*.vue",
            "options": { "parser": "vue" }
        }
    ]
}
